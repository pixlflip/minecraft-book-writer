{
  "schemaVersion": 1,
  "id": "bookwriter",
  "version": "${version}",
  "name": "Book Writer",
  "description": "Import long text into a book and quill: paste from the clipboard or from a web link, with a preview, automatic page breaks, undo and continue-in-next-book.",
  "authors": [
    "Jack"
  ],
  "contact": {
    "homepage": "https://github.com/pixlflip/minecraft-book-writer",
    "sources": "https://github.com/pixlflip/minecraft-book-writer",
    "issues": "https://github.com/pixlflip/minecraft-book-writer/issues"
  },
  "license": "MIT",
  "icon": "assets/bookwriter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.bookwriter.BookWriterMod"
    ]
  },
  "mixins": [
    "bookwriter.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${mc_range}",
    "java": ">=${java}"
  }
}
